<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hlavička s databázou -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvDb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.9"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnImport"
                    style="@style/Btn.OnHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_upload"
                    android:text="@string/import_db" />

                <Button
                    android:id="@+id/btnMissing"
                    style="@style/Btn.OnHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_alert" />
            </LinearLayout>
        </LinearLayout>

        <!-- Formulár -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- 1. Skladová karta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/StepBadge" android:text="1" />
                <TextView style="@style/Label" android:text="@string/label_card" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <AutoCompleteTextView
                    android:id="@+id/etCard"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:completionThreshold="1"
                    android:dropDownVerticalOffset="6dp"
                    android:hint="@string/hint_card"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:popupBackground="@drawable/popup_bg" />

                <Button
                    android:id="@+id/btnClearCard"
                    style="@style/Btn.Round"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/clear"
                    android:drawableStart="@drawable/ic_close"
                    android:drawableTint="@color/primary_dark"
                    android:paddingStart="13dp"
                    android:minHeight="48dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCode"
                    style="@style/Input"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:hint="@string/hint_code"
                    android:imeOptions="actionSearch"
                    android:inputType="number"
                    android:maxLength="12"
                    android:singleLine="true"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCardInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/primary_dark"
                    android:textSize="13sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- 2. EAN / QR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/StepBadge" android:text="2" />
                <TextView style="@style/Label" android:text="@string/label_ean" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEan"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:hint="@string/hint_ean"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnScan"
                    style="@style/Btn.Scan"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_scan"
                    android:text="@string/scan" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:layout_marginTop="6dp"
                android:text="@string/nfc_hint" />

            <!-- 3. Množstvo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/StepBadge" android:text="3" />
                <TextView style="@style/Label" android:text="@string/label_qty" />
                <TextView
                    android:id="@+id/tvStock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMinus"
                    style="@style/Btn.Round"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="−" />

                <EditText
                    android:id="@+id/etQty"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:hint="@string/hint_qty"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:minHeight="58dp"
                    android:textSize="26sp" />

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/Btn.Round"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="+" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAdd"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/ic_check"
                android:paddingStart="24dp"
                android:paddingEnd="48dp"
                android:text="@string/add"
                android:textSize="17sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnList"
            style="@style/Btn.Tonal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:drawableStart="@drawable/ic_list"
            android:paddingStart="24dp"
            android:paddingEnd="48dp" />

        <TextView
            android:id="@+id/tvRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
